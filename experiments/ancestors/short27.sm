; short27 -- evolved, not written.  From flaw-3b-s6, genotype 0027gkm.
; 27 cells, 178 instructions for its first daughter -- and that is all it makes.
; It then falls out of its own copy loop and grinds through hundreds of errors
; before it can start again, so a population of it spends 1,573 instructions per
; birth where the ancestor spends 468.  Kept because the contrast with
; short27r.sm is finding 18: same length, same solo cost, eight times the price.
;
; An earlier version of this header said repeats=True.  That was the assay
; counting the genotype's births rather than the mother's; see the test.

        .t 1
        divide
        adrb    ; seeks 1
        .t 0
        pushC
        pushA
        adrf    ; seeks 1
        .t 0
        popB
        subCAB
        incC
        incC
        pushB
        pushB
        mal
        movBA
        popA
        .t 0
        decC
        movii
        incA
        incB
        ifz
        divide
        jmpb    ; seeks 0
        .t 1
        jmpb
